rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.uid == "xwX5eCsUqpRLIBAI3K5Y7y70HLp1";
    }

    // ── USERS ──
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
      allow list:  if isAdmin(); // Autoriser le listage pour les 10 derniers connectés
    }

    // ── DAILIES ──
    match /dailies/{dateId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── ROOMS ──
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.creatorUid || isAdmin());
      allow list: if isAdmin();
    }

    // ── STATS GLOBALES ──
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
