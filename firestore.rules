rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.uid == "xwX5eCsUqpRLIBAI3K5Y7y70HLp1";
    }

    // ── USERS ──
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || resource.data.isPublic == true || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
      allow list:  if request.auth != null; // On filtrera par isPublic dans la requête
    }

    // ── DAILIES ──
    match /dailies/{dateId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── ROOMS ──
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.creatorUid || isAdmin());
      allow list: if isAdmin();
    }

    // ── STATS GLOBALES ──
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── SOLO DRAFTS ──
    match /solo_drafts/{draftId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

  }
}
